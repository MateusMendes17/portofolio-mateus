# ==============================================
# Portfólio Mateus Mendes — Environment Variables
# ==============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to the repository.

# Resend API key (for the contact form)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email that receives contact form submissions.
# Falls back to the public site email if unset.
CONTACT_EMAIL=hello@mateusmendes.pt

# Sender address shown in the notification email.
# `onboarding@resend.dev` only works on Resend test accounts; in production set
# an address on a verified domain (e.g. "Portfólio Mateus <hello@mateusmendes.pt>").
RESEND_FROM=Portofolio Mateus <hello@mateusmendes.pt>

# Site URL (used for metadata and sitemap)
NEXT_PUBLIC_SITE_URL=https://mateusmendes.pt
