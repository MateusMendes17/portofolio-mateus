# ==============================================
# Portfólio Mateus Mendes — Environment Variables
# ==============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to the repository.

# Resend API key (for the contact form)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email that receives contact form submissions.
# Falls back to the public site email if unset.
CONTACT_EMAIL=hello@mateusmendes.pt

# Sender address shown in the notification email.
# `onboarding@resend.dev` only works on Resend test accounts; in production set
# an address on a verified domain (e.g. "Portfólio Mateus <hello@mateusmendes.pt>").
RESEND_FROM=Portofolio Mateus <hello@mateusmendes.pt>

# Site URL (used for metadata and sitemap)
NEXT_PUBLIC_SITE_URL=https://mateusmendes.pt

# ==============================================
# Avaliador de Sites (/avaliador)
# ==============================================
# Chave da API do Google PageSpeed Insights v5 (estratégia mobile).
# Opcional: se omitida ou inválida, o avaliador continuará a funcionar
# apenas com as verificações próprias (segurança, SEO, mobile, a11y, peso)
# e indicará "Dados de desempenho indisponíveis agora".
#
# Como obter:
# 1. Aceda a https://developers.google.com/speed/docs/insights/v5/get-started
# 2. Clique em "Get a Key" ou vá à Google Cloud Console e ative a "PageSpeed Insights API"
# 3. Crie uma credencial de chave de API e cole aqui:
PAGESPEED_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ==============================================
# Marcação de chamadas (Cal.com)
# ==============================================
# Ligação pública da sua página de agendamento. Sem este valor, os botões
# "Marcar chamada" não aparecem no site. Tem de começar por https://
NEXT_PUBLIC_CAL_URL=https://cal.com/o-seu-utilizador/15min
# Opcional: chamada de 30 minutos (mostra um seletor 15/30 min no separador de marcação).
NEXT_PUBLIC_CAL_URL_30=https://cal.com/o-seu-utilizador/30min
